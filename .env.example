# Copy to .env and adjust. Never commit .env.
# Use only URL-safe characters (letters, digits, - _ .) in passwords: they are embedded in URLs.

# --- PostgreSQL (Docker Compose creates the database with these credentials) ---
POSTGRES_USER=knowvault
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=knowvault
# Host port for the Compose database. Change it if another Postgres already uses 5432.
POSTGRES_PORT=5432

# --- API ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Used when running the API directly on your machine. Docker Compose builds its own URL.
DATABASE_URL=postgresql+asyncpg://knowvault:change-me-dev-only@localhost:5432/knowvault
# Dropped and recreated by the test suite; the name must end in _test.
TEST_DATABASE_URL=postgresql+asyncpg://knowvault:change-me-dev-only@localhost:5432/knowvault_test
# Origin the browser uses to reach the web app. State-changing API calls must come from it.
APP_ORIGIN=http://localhost:3000
# Must be true in production (HTTPS only).
SESSION_COOKIE_SECURE=false

# --- Web ---
# Where the Next.js server forwards /api/* requests.
API_INTERNAL_URL=http://localhost:8000
