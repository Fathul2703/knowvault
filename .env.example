# Copy to .env and adjust. Never commit .env.
# Use only URL-safe characters (letters, digits, - _ .) in passwords: they are embedded in URLs.

# --- PostgreSQL (Docker Compose creates the database with these credentials) ---
POSTGRES_USER=knowvault
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=knowvault
# Host port for the Compose database. Change it if another Postgres already uses 5432.
POSTGRES_PORT=5432

# --- API ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Used when running the API directly on your machine. Docker Compose builds its own URL.
DATABASE_URL=postgresql+asyncpg://knowvault:change-me-dev-only@localhost:5432/knowvault
# Dropped and recreated by the test suite; the name must end in _test.
TEST_DATABASE_URL=postgresql+asyncpg://knowvault:change-me-dev-only@localhost:5432/knowvault_test
# Origin the browser uses to reach the web app. State-changing API calls must come from it.
APP_ORIGIN=http://localhost:3000
# Must be true in production (HTTPS only).
SESSION_COOKIE_SECURE=false
# Where the API and the worker keep uploaded files when run on your machine (relative to
# apps/api, where `make api` and `make worker` run). Docker Compose uses a volume instead.
STORAGE_DIR=../../data/uploads
# Embedding model: bge-m3 (BAAI/bge-m3, int8 ONNX, runs locally, downloaded on first use).
# "fake" is for tests only and is refused when ENVIRONMENT=production.
EMBEDDING_PROVIDER=bge-m3
# Where model files are stored when running on your machine (relative to apps/api).
EMBEDDING_CACHE_DIR=../../data/models
# Chunk sizes in characters (docs/adr/0014-chunk-sizes.md). After changing them, run
# `knowvault reindex --all` to re-chunk existing documents.
CHUNK_TARGET_CHARS=1000
CHUNK_MAX_CHARS=1400
CHUNK_OVERLAP_CHARS=150
# Knowledge graph extraction after processing: heuristic (offline, default) or none.
GRAPH_EXTRACTOR=heuristic
# Name similarity needed to merge a newly found name into an existing entity (1 = off).
GRAPH_MERGE_THRESHOLD=0.82
# Hybrid search through the graph: none, entities or neighbours. Off by default: it lowered
# Success@1 on the evaluation set (docs/adr/0018-graph-retrieval.md).
GRAPH_RETRIEVAL=none
# Optional cross-encoder that reorders hybrid search results: none or bge-reranker-v2-m3. Off by
# default: on a CPU it adds about 2.5 s per search for a small gain (docs/adr/0013-reranking.md).
RERANKER=none
# Answer generation. "fake" quotes your documents without a language model, so the stack
# runs without an API key; it is refused when ENVIRONMENT=production. "anthropic" uses Claude
# and needs ANTHROPIC_API_KEY. Selected passages of your documents are sent to the provider.
LLM_PROVIDER=fake
LLM_MODEL=claude-sonnet-5-5
# Rewrites follow-up questions into standalone search queries.
LLM_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
# Tokens (input + output) each user may spend on answers per UTC day.
CHAT_DAILY_TOKEN_LIMIT=200000

# --- Limits ---
# Per user: questions per minute, searches per minute, uploads and note saves per hour, and
# documents in total.
CHAT_QUESTIONS_PER_MINUTE=10
SEARCHES_PER_MINUTE=60
DOCUMENT_WRITES_PER_HOUR=120
MAX_DOCUMENTS_PER_USER=2000
# Per client address: failed logins per login window (15 minutes) and registrations per hour.
LOGIN_IP_MAX_ATTEMPTS=50
REGISTER_IP_MAX_ATTEMPTS=10
# Comma-separated addresses or networks of reverse proxies that set X-Forwarded-For, e.g. the
# production proxy. Only their header is believed; leave empty when clients reach the API
# directly or through the Next.js development proxy (which does not overwrite the header).
TRUSTED_PROXIES=

# --- Web ---
# Where the Next.js server forwards /api/* requests.
API_INTERNAL_URL=http://localhost:8000
