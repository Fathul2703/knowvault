# Production settings for compose.prod.yaml. Copy to .env.prod (never commit it) and fill in.

# Public host name; Caddy obtains a certificate for it (ports 80 and 443 must reach this host).
DOMAIN=knowvault.example.com
POSTGRES_USER=knowvault
# Long and random; letters and digits only, as it is part of a database URL.
POSTGRES_PASSWORD=
POSTGRES_DB=knowvault

# Answers are written by Claude. Selected passages of users' documents are sent to Anthropic.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_FAST_MODEL=claude-haiku-4-5-20251001
# Tokens (input + output) each user may spend on answers per UTC day.
CHAT_DAILY_TOKEN_LIMIT=200000
